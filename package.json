{
  "name": "portfolio-website-astrojs",
  "description": "This is my portfolio website, based on Unicorn Sparkle template from UXCorpRangel.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "dev": "astro dev",
    "prepare": "is-ci || husky",
    "preview": "astro preview",
    "start": "astro dev",
    "deploy": "npm install --omit=dev --ignore-scripts",
    "check-types": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.14",
    "@astrojs/sitemap": "^3.7.6",
    "@astrolicious/i18n": "^0.6.3",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@inox-tools/aik-route-config": "^0.7.5",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "astro-integration-kit": "~0.17.0",
    "astro-seo-schema": "^5.2.0",
    "astro-tunnel": "^0.1.9",
    "i18next": "^26.7.2",
    "resend": "^6.39.0",
    "sanitize.css": "^13.0.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro,css,json,yml,yaml}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
